{
  "name": "NO SUS Chat",
  "short_name": "NO SUS",
  "description": "Your NO SUS chat on this computer, opened by your phone.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "icons": [
    { "src": "/app_icon_192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app_icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-to-chat",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}
